{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>woodleighschool/renovate-config"],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^repositories\\.json$/"],
      matchStrings: [
        '"url": "(?<depName>https://github\\.com/[^"]+)",\\n\\s+"ref": "(?<currentValue>[^"]+)",\\n\\s+"revision": "(?<currentDigest>[0-9a-f]{40})"',
      ],
      datasourceTemplate: "git-refs",
    },
  ],
  packageRules: [
    {
      matchDatasources: ["git-refs"],
      matchManagers: ["custom.regex"],
      groupName: "AutoPkg repositories",
      groupSlug: "autopkg-repositories",
    },
    {
      matchManagers: ["mise"],
      minimumReleaseAge: "12 hours",
    },
  ],
}
